    ],
    "applyCmd": [
      "sh",
      "-c",
      "mkdir -p \"$HOME/Pictures/Screenshots\"; killall SystemUIServer"
    ],
    "revertCmd": [
      "sh",
      "-c",
      "mkdir -p \"$HOME/Pictures/Screenshots\"; killall SystemUIServer"
    ]
