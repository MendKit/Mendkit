  {
    "id": "screenshots-folder",
    "group": "Screenshots",
    "admin": false,
    "name": "Save screenshots to a folder",
    "description": "Puts screenshots in Pictures, Screenshots instead of all over the desktop.",
    "entries": [
      {
        "path": "com.apple.screencapture",
        "name": "location",
        "type": "string",
        "on": "~/Pictures/Screenshots",
        "off": null
