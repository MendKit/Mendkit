      }
    ],
    "needsSignOut": true
  },
  {
    "id": "kde-no-indexing",
    "group": "Speed",
    "admin": false,
    "name": "Turn off file search indexing",
    "description": "Stops Baloo indexing every file in the background. A big speed-up on older computers; file search by content stops working.",
    "desktops": [
      "kde",
      "plasma"
    ],
    "entries": [
      {
        "path": "kde:baloofilerc|Basic Settings",
        "name": "Indexing-Enabled",
        "type": "bool",
        "on": "false",
        "off": null
      }
    ],
    "applyCmd": [
      "sh",
      "-c",
      "balooctl6 disable 2>/dev/null || balooctl disable 2>/dev/null; true"
    ],
    "revertCmd": [
      "sh",
      "-c",
      "balooctl6 enable 2>/dev/null || balooctl enable 2>/dev/null; true"
    ]
  },
  {
    "id": "kde-no-animations",
    "group": "Speed",
    "admin": false,
    "name": "Turn off animations",
    "description": "Windows and menus appear instantly. Feels faster on older computers.",
    "desktops": [
      "kde",
      "plasma"
    ],
    "entries": [
      {
        "path": "kde:kdeglobals|KDE",
        "name": "AnimationDurationFactor",
        "type": "string",
        "on": "0",
        "off": null
      }
    ],
    "applyCmd": [
      "sh",
      "-c",
      "qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null || qdbus org.kde.KWin /KWin reconfigure 2>/dev/null; true"
    ],
    "revertCmd": [
      "sh",
      "-c",
      "qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null || qdbus org.kde.KWin /KWin reconfigure 2>/dev/null; true"
    ]
  },
