  {
    "id": "xfce-no-tearing",
    "group": "Display",
    "admin": false,
    "name": "Stop screen tearing",
    "description": "Uses the graphics card to sync drawing with the screen, which stops tearing lines in videos and scrolling.",
    "desktops": [
      "xfce"
    ],
    "entries": [
      {
        "path": "xfconf:xfwm4",
        "name": "/general/vblank_mode",
        "type": "string",
        "on": "glx",
        "off": null
      }
    ],
    "applyCmd": [
      "sh",
      "-c",
      "xfwm4 --replace >/dev/null 2>&1 & true"
    ],
    "revertCmd": [
      "sh",
      "-c",
      "xfwm4 --replace >/dev/null 2>&1 & true"
    ]
  },
