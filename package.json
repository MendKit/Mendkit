{
  "name": "mendkit",
  "version": "0.19.3",
  "description": "MendKit - repair, tool, tune and migrate Windows, macOS and Linux computers",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && node dist/scripts/smoke-test.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.0"
  },
  "author": "MendKit",
  "build": {
    "appId": "com.mendkit.app",
    "productName": "MendKit",
    "copyright": "MendKit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/scripts/**",
      "renderer/**/*",
      "definitions/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MendKit",
      "artifactName": "MendKit-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MendKit-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "MendKit uses the camera only for the camera test in Hardware Tests.",
        "NSMicrophoneUsageDescription": "MendKit uses the microphone only for the microphone test in Hardware Tests.",
        "NSAppleEventsUsageDescription": "MendKit asks System Events to list and remove login items.",
        "NSDesktopFolderUsageDescription": "MendKit backs up, moves and cleans files on the Desktop when you ask it to.",
        "NSDocumentsFolderUsageDescription": "MendKit backs up and moves files in Documents when you ask it to.",
        "NSDownloadsFolderUsageDescription": "MendKit backs up, moves and measures files in Downloads when you ask it to.",
        "NSRemovableVolumesUsageDescription": "MendKit backs up to, restores from and checks USB drives when you ask it to.",
        "NSNetworkVolumesUsageDescription": "MendKit backs up to and restores from network drives when you ask it to."
      },
      "artifactName": "MendKit-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "System",
      "icon": "build/icon.png",
      "synopsis": "Repair, tune and migrate computers",
      "artifactName": "MendKit-${version}-${arch}.${ext}",
      "maintainer": "MendKit <mendkit@users.noreply.github.com>",
      "vendor": "MendKit",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-a4ba3af629e94c87a8e9aec1b8e48df7.r2.dev"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ],
      "priority": "optional"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid"
      ]
    },
    "asarUnpack": [
      "definitions/scripts/**"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "homepage": "https://mendkit.github.io",
  "desktopName": "mendkit.desktop"
}
